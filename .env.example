# Higgsfield credentials — VARIABLE NAMES ONLY. Copy to .env and paste the real
# values there; .env is git-ignored and is never read by this repo's code except
# through `node --env-file=.env` (see the assets:* npm scripts).
#
# The account credential is a single "<key-id>:<key-secret>" string. Put it in
# HF_API_KEY (or HF_CREDENTIALS). Use HF_API_SECRET only if your key and secret
# are two separate strings.
#
# The game NEVER reads these: only scripts/generate-assets.mjs does, and only
# for the modes that talk to the API (--probe/--estimate/--generate/--redo).

HF_API_KEY=
HF_CREDENTIALS=
HF_API_SECRET=
